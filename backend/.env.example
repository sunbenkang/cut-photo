# FastAPI Secret Key (change in production)
SECRET_KEY=your-random-secret-key-here

# DashScope / Alibaba Cloud Model Studio
# No separate API key needed — users authenticate with their own AppKey (DashScope API Key)

# TMDB API Key for movie search (get from https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# CORS origins
CORS_ORIGINS=["http://localhost:3000"]
